    "test:repair-flow": "node tests/repair-flow.cjs",
    "test:repair-edit": "node tests/repair-edit.cjs",
    "test:platform-admin-metrics": "node tests/platform-admin-metrics.cjs",
    "test:expired-owner-renewal-ui": "node tests/expired-owner-renewal-ui.cjs",
    "test:account-deletion": "node tests/browser-security-runner.cjs --account",
