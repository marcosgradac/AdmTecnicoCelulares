{
  "rewrites": [
    {
      "source": "/s/:clientSlug/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebot|[Ww]hats[Aa]pp).*"
        }
      ],
      "destination": "https://tecnodesk-api.onrender.com/api/tracking-preview/:token?clientSlug=:clientSlug"
    },
    {
      "source": "/seguimiento/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebot|[Ww]hats[Aa]pp).*"
        }
      ],
      "destination": "https://tecnodesk-api.onrender.com/api/tracking-preview/:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
