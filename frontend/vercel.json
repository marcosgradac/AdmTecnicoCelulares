{
  "git": {
    "deploymentEnabled": {
      "codex/repair-hard-delete-main": false,
      "codex/remove-repair-cancellation": false,
      "codex/equipment-resale-details-delete": false,
      "feature/premium-dark-mode": false,
      "feature/mobile-ux-carousels": false,
      "codex/seo-search-console": false
    }
  },
  "rewrites": [
    {
      "source": "/s/:clientSlug/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebot|[Ww]hats[Aa]pp).*"
        }
      ],
      "destination": "https://api.tecnodeskpro.com/api/tracking-preview/:token?clientSlug=:clientSlug"
    },
    {
      "source": "/seguimiento/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
