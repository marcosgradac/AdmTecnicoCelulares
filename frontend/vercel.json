{
  "git": { "deploymentEnabled": { "codex/repair-hard-delete-main": false, "codex/remove-repair-cancellation": false, "codex/equipment-resale-details-delete": false, "feature/premium-dark-mode": false, "feature/mobile-ux-carousels": false } },
  "rewrites": [
    {
      "source": "/s/:clientSlug/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebot|[Ww]hats[Aa]pp).*"
        }
      ],
      "destination": "https://api.tecnodeskpro.com/api/tracking-preview/:token?clientSlug=:clientSlug"
    },
    {
      "source": "/seguimiento/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebot|[Ww]hats[Aa]pp).*"
        }
      ],
      "destination": "https://api.tecnodeskpro.com/api/tracking-preview/:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.tecnodeskpro.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ],
      "source": "/(.*)"
    }
  ]
}
