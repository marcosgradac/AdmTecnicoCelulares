  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.12.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3"
  }
