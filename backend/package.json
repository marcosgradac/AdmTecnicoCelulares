    "test:dashboard-summary": "tsx tests/dashboard-summary-contract.ts",
    "test:tenant-isolation": "tsx tests/tenant-isolation.ts",
    "test:money-concurrency": "tsx tests/money-concurrency.ts",
    "test:commerce-stock-race": "tsx tests/commerce-stock-race.ts",
    "test:billing": "tsx tests/billing.ts",
    "test:billing-quota-concurrency": "tsx tests/billing-quota-concurrency.ts",
    "test:billing-pending-concurrency": "tsx tests/pending-payment-concurrency.ts",
    "test:commerce": "tsx tests/commerce.ts && tsx tests/commerce-sqlite.ts",
    "test:equipment-sales": "tsx tests/equipment-sales.ts && tsx tests/equipment-sales-sqlite.ts",
    "test:performance-access": "tsx tests/performance-access.ts",
    "test:subscription-lifecycle": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs tests/subscription-lifecycle.ts",
