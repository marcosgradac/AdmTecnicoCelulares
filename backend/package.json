    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:postgres:start": "node tools/postgres-dev.mjs",
    "migrate:postgres": "tsx src/scripts/migrate-sqlite-to-postgres.ts",
    "migrate:postgres:dry-run": "tsx src/scripts/migrate-sqlite-to-postgres.ts --dry-run",
    "test:password-reset": "tsx tests/password-reset.ts",
    "test:password-change": "tsx tests/password-change.ts",
    "test:account-deletion": "tsx tests/account-deletion.ts",
