NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://usuario:password@localhost:5432/cellufix?schema=public
JWT_SECRET=replace-with-a-long-secure-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Public origin for relative Open Graph logos. Keep Render until the new domain is verified.
PUBLIC_API_ORIGIN=https://tecnodesk-api.onrender.com
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_SIGNUP_MAX=3
RATE_LIMIT_PASSWORD_CODE_USER_MAX=3
RATE_LIMIT_PASSWORD_CODE_IP_MAX=10
RATE_LIMIT_PASSWORD_VERIFY_MAX=15
RATE_LIMIT_PUBLIC_TRACKING_MAX=60
# Independent social-preview budget per IP per minute (IPv6 subnet-aware).
RATE_LIMIT_TRACKING_PREVIEW_MAX=30
# Independent PostgreSQL readiness budget per IP per minute; /health is DB-free.
RATE_LIMIT_HEALTH_MAX=30
RATE_LIMIT_AUTH_WRITES_MAX=30
RATE_LIMIT_SUPER_ADMIN_WRITES_MAX=20
JSON_PAYLOAD_LIMIT=256kb
TURNSTILE_SECRET_KEY=
MAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM=
# Alias compatible si el servicio ya usa este nombre en Railway.
RESEND_FROM_EMAIL=
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5
DEMO_USER_EMAIL=
DEMO_ALLOW_PRODUCTION=false
SUPER_ADMIN_EMAIL=

# Solo para migraciones manuales desde la base histórica; no son necesarias en Railway.
SQLITE_DATABASE_URL=file:../dev.db
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Experimental client identity: keep baseline; do not activate without separate audit.
CLIENT_IP_MODE=baseline
# Required only in cf mode behind the documented public Render ingress; leave empty.
CLIENT_IP_CF_TRUST_ACK=
# CF-only invalid-header rejection budget per process/minute, integer 1..600.
# Valid requests do not consume it; overflow returns 429 without reaching parsers/DB.
CLIENT_IP_INVALID_MAX=60
# CF-only preview ceiling per IP/minute, integer 1..600. Per-IP+link uses
# RATE_LIMIT_TRACKING_PREVIEW_MAX (default 30). Baseline retains 30/IP plus its link/process caps.
RATE_LIMIT_TRACKING_PREVIEW_CF_MAX=120

# Experimental CF-only total preview admission ceiling per process/minute (1..600).
# Not a production-approved value; does not replace a distributed limit.
RATE_LIMIT_TRACKING_PREVIEW_PROCESS_MAX=120

# Proposed baseline preview budgets; no production environment changes in this PR.
# Per-IP+link cap; effective value is capped by RATE_LIMIT_TRACKING_PREVIEW_MAX.
RATE_LIMIT_TRACKING_PREVIEW_BASELINE_LINK_MAX=10
# Independent preview process admission cap; not shared with the global API limiter.
RATE_LIMIT_TRACKING_PREVIEW_BASELINE_PROCESS_MAX=600
