generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RepairStatus {
  RECEIVED
  REVIEW
  BUDGET
  APPROVED
  WAITING_PART
  REPAIRING
  TESTING
  READY
  DELIVERED
  CANCELLED
  WARRANTY
}

enum UserRole {
  OWNER
  TECHNICIAN
}

model Business {
  id            String         @id @default(cuid())
  name          String
  slug          String?        @unique
  phone         String?
  address       String?
  logoUrl       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  clients       Client[]
  repairs       Repair[]
  stockItems    StockItem[]
  cashMovements CashMovement[]
  payments      Payment[]
  devices       Device[]
  inventoryMovements InventoryMovement[]
}

model User {
  id                  String                @id @default(cuid())
  businessId          String
  name                String
  firstName           String?
  lastName            String?
  phone               String?
  email               String                @unique
  passwordHash        String
  role                UserRole              @default(TECHNICIAN)
  isActive            Boolean               @default(true)
  tokenVersion        Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  business            Business              @relation(fields: [businessId], references: [id])
  passwordResetTokens PasswordResetToken[]
  repairStatusHistory RepairStatusHistory[]
  inventoryMovements  InventoryMovement[]

  @@index([businessId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id         String    @id @default(cuid())
  businessId String
  name       String
  phone      String?
  whatsapp   String?
  email      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  repairs    Repair[]
  devices    Device[]
  payments   Payment[]
  business   Business  @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model Device {
  id                  String   @id @default(cuid())
  businessId          String
  clientId            String
  brand               String
  model               String
  imei                String?
  color               String?
  storage             String?
  unlockCodeEncrypted String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  business            Business @relation(fields: [businessId], references: [id])
  client              Client   @relation(fields: [clientId], references: [id])
  repairs             Repair[]

  @@index([businessId])
  @@index([clientId])
}

model Repair {
  id                    String                @id @default(cuid())
  businessId            String
  number                Int
  clientId              String
  deviceId              String?
  deviceBrand           String
  deviceModel           String
  imei                  String?
  color                 String?
  issue                 String
  diagnosis             String?
  notes                 String?
  physicalCondition     String?
  accessories           String?
  estimatedDeliveryDate DateTime?
  estimatedDuration     String?
  partsCost             Int                   @default(0)
  laborCost             Int                   @default(0)
  status                RepairStatus          @default(RECEIVED)
  total                 Int                   @default(0)
  paid                  Int                   @default(0)
  trackingToken         String?               @unique
  trackingEnabled       Boolean               @default(false)
  deliveredAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  client                Client                @relation(fields: [clientId], references: [id])
  device                Device?               @relation(fields: [deviceId], references: [id])
  payments              Payment[]
  parts                 RepairPart[]
  business              Business              @relation(fields: [businessId], references: [id])
  statusHistory         RepairStatusHistory[]
  photos                RepairPhoto[]
  inventoryMovements    InventoryMovement[]

  @@unique([businessId, number])
  @@index([businessId])
}

model RepairStatusHistory {
  id              String        @id @default(cuid())
  repairId        String
  previousStatus  RepairStatus?
  newStatus       RepairStatus
  publicMessage   String?
  internalNote    String?
  changedByUserId String
  createdAt       DateTime      @default(now())
  repair          Repair        @relation(fields: [repairId], references: [id], onDelete: Cascade)
  changedBy       User          @relation(fields: [changedByUserId], references: [id])

  @@index([repairId, createdAt])
}

model RepairPhoto {
  id        String   @id @default(cuid())
  repairId  String
  url       String
  type      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId])
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

model Payment {
  id         String        @id @default(cuid())
  businessId String
  repairId   String
  clientId   String
  amount     Int
  method     PaymentMethod
  note       String?
  createdAt  DateTime      @default(now())
  repair     Repair        @relation(fields: [repairId], references: [id])
  client     Client        @relation(fields: [clientId], references: [id])
  business   Business      @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model StockItem {
  id              String       @id @default(cuid())
  businessId      String
  name            String
  sku             String?
  category        String
  compatibleBrand String?
  compatibleModel String?
  compatibleModels String[]     @default([])
  quality         String?
  supplier        String?
  notes           String?
  quantity        Int          @default(0)
  minimumStock    Int          @default(0)
  cost            Int          @default(0)
  salePrice       Int          @default(0)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  repairParts     RepairPart[]
  movements       InventoryMovement[]
  business        Business     @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@unique([businessId, sku])
}

model RepairPart {
  id               String    @id @default(cuid())
  repairId         String
  stockItemId      String
  quantity         Int
  unitCost         Int
  unitPrice        Int
  itemNameSnapshot String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  repair           Repair    @relation(fields: [repairId], references: [id])
  stockItem        StockItem @relation(fields: [stockItemId], references: [id])

  @@index([repairId])
  @@index([stockItemId])
}

enum InventoryMovementType {
  INITIAL_STOCK
  PURCHASE
  MANUAL_ENTRY
  REPAIR_USAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  DAMAGED
  CANCELLED_REPAIR_RETURN
}

model InventoryMovement {
  id                String                @id @default(cuid())
  businessId        String
  stockItemId       String
  repairId          String?
  type              InventoryMovementType
  quantity          Int
  unitCost          Int
  totalCost         Int
  previousStock     Int
  newStock          Int
  notes             String?
  createdByUserId   String
  createdAt         DateTime              @default(now())
  business          Business              @relation(fields: [businessId], references: [id])
  stockItem         StockItem             @relation(fields: [stockItemId], references: [id])
  repair            Repair?               @relation(fields: [repairId], references: [id])
  createdBy         User                  @relation(fields: [createdByUserId], references: [id])

  @@index([businessId, createdAt])
  @@index([stockItemId, createdAt])
  @@index([repairId])
}

enum CashMovementType {
  INCOME
  EXPENSE
}

model CashMovement {
  id          String           @id @default(cuid())
  businessId  String
  type        CashMovementType
  description String
  amount      Int
  method      PaymentMethod?
  repairId    String?
  clientName  String?
  createdAt   DateTime         @default(now())
  business    Business         @relation(fields: [businessId], references: [id])

  @@index([businessId])
}
