generator client {
  provider = "prisma-client-js"
  output   = "../../generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

enum RepairStatus {
  RECEIVED
  REVIEW
  BUDGET
  APPROVED
  REPAIRING
  TESTING
  READY
  DELIVERED
}

enum UserRole {
  OWNER
  TECHNICIAN
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

enum CashMovementOrigin {
  GENERAL
  REPAIR
  EQUIPMENT
  COMMERCE
}

enum CashMovementType {
  INCOME
  EXPENSE
}

model Business {
  id            String         @id @default(cuid())
  name          String
  slug          String?        @unique
  phone         String?
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  clients       Client[]
  repairs       Repair[]
  stockItems    StockItem[]
  cashMovements CashMovement[]
  payments      Payment[]
  commerceProducts CommerceProduct[]
  commerceSales CommerceSale[]
  commerceCategories CommerceCategory[]
  resaleDevices      ResaleDevice[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TECHNICIAN)
  isActive     Boolean  @default(true)
  tutorialSeen Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model Client {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  repairs    Repair[]
  payments   Payment[]
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model Repair {
  id            String       @id @default(cuid())
  businessId    String
  number        Int
  clientId      String
  deviceBrand   String
  deviceModel   String
  imei          String?
  color         String?
  issue         String
  diagnosis     String?
  notes         String?
  status        RepairStatus @default(RECEIVED)
  total         Int          @default(0)
  paid          Int          @default(0)
  trackingToken String       @unique @default(cuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  client        Client       @relation(fields: [clientId], references: [id])
  payments      Payment[]
  parts         RepairPart[]
  business      Business     @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@unique([businessId, number])
}

model Payment {
  id         String        @id @default(cuid())
  businessId String
  repairId   String
  clientId   String
  amount     Int
  method     PaymentMethod
  note       String?
  createdAt  DateTime      @default(now())
  repair     Repair        @relation(fields: [repairId], references: [id])
  client     Client        @relation(fields: [clientId], references: [id])
  business   Business      @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model StockItem {
  id              String       @id @default(cuid())
  businessId      String
  name            String
  category        String
  compatibleBrand String?
  compatibleModel String?
  quantity        Int          @default(0)
  minimumStock    Int          @default(0)
  cost            Int          @default(0)
  salePrice       Int          @default(0)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  repairParts     RepairPart[]
  business        Business     @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model RepairPart {
  id               String    @id @default(cuid())
  repairId         String
  stockItemId      String
  quantity         Int
  unitCost         Int
  unitPrice        Int
  itemNameSnapshot String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  repair           Repair    @relation(fields: [repairId], references: [id])
  stockItem        StockItem @relation(fields: [stockItemId], references: [id])

  @@index([repairId])
  @@index([stockItemId])
}

model CashMovement {
  resaleDeviceId String?
  resaleDevice   ResaleDevice? @relation(fields: [resaleDeviceId], references: [id], onDelete: Restrict)
  resaleKind     EquipmentCashKind?
  resaleVersion  Int?

  @@unique([resaleDeviceId, resaleVersion, resaleKind])

  id          String           @id @default(cuid())
  businessId  String
  type        CashMovementType
  description String
  amount      Int
  method      PaymentMethod?
  origin      CashMovementOrigin @default(GENERAL)
  repairId    String?
  clientName  String?
  commerceSaleId String? @unique
  createdAt   DateTime         @default(now())
  business    Business         @relation(fields: [businessId], references: [id])
  commerceSale CommerceSale?   @relation(fields: [commerceSaleId], references: [id])

  @@index([businessId])
  @@index([businessId, origin, createdAt, id])
}

model CommerceProduct {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  category     String
  purchaseCost Int
  salePrice    Int
  currentStock Int           @default(0)
  minimumStock Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id])
  saleLines    CommerceSaleLine[]

  @@index([businessId, active])
  @@index([businessId, category])
  @@index([businessId, currentStock])
}

model CommerceCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
}

model CommerceSale {
  // Nullable only for sales created before idempotency was introduced.
  idempotencyKey  String?
  id              String            @id @default(cuid())
  businessId      String
  total           Int
  costOfGoodsSold Int
  profit          Int
  paymentMethod   PaymentMethod
  createdAt       DateTime          @default(now())
  business        Business          @relation(fields: [businessId], references: [id])
  lines           CommerceSaleLine[]
  cashMovement    CashMovement?

  @@unique([businessId, idempotencyKey])

  @@index([businessId, createdAt])
}

model CommerceSaleLine {
  id            String          @id @default(cuid())
  saleId        String
  productId     String
  productName   String
  quantity      Int
  unitCost      Int
  unitPrice     Int
  lineTotal     Int
  lineCost      Int
  lineProfit    Int
  sale          CommerceSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       CommerceProduct @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId, saleId])
}

enum ResaleDeviceStatus {
  PURCHASED
  REPAIRING
  READY_FOR_SALE
  SOLD
}

enum EquipmentCashKind {
  PURCHASE
  REPAIR
  PURCHASE_ADJUSTMENT
  REPAIR_ADJUSTMENT
  SALE
}

model ResaleDevice {
  id                 String @id @default(cuid())
  businessId         String
  brand              String
  model              String
  purchasePrice      Int
  repairExpenses     Int @default(0)
  estimatedSalePrice Int
  status             ResaleDeviceStatus @default(PURCHASED)
  version            Int @default(0)
  actualSalePrice    Int?
  salePaymentMethod  PaymentMethod?
  saleCostBasis      Int?
  soldAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  business           Business @relation(fields: [businessId], references: [id])
  cashMovements      CashMovement[]

  @@index([businessId, createdAt, id])
  @@index([businessId, status, createdAt, id])
  @@index([businessId, soldAt])
}
