{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci && npm run build"
  },
  "deploy": {
    "preDeployCommand": "npm run migrate:deploy",
    "startCommand": "npm run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
